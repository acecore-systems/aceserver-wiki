{
  "name": "@acecore/discord-oidc-broker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "cf:typegen": "wrangler types && node scripts/normalize-generated-types.mjs",
    "check": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:keygen",
    "test:keygen": "node --test tests/generate-signing-key.test.mjs",
    "test:unit": "vitest run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.0",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "undici@^7.0.0": "7.30.1",
    "@cloudflare/vitest-plugin": {
      "zod": "4.6.6"
    }
  }
}
