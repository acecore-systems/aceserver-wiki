{
  "name": "@acecore/discord-oidc-broker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "cf:typegen": "wrangler types && node scripts/normalize-generated-types.mjs",
    "check": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:keygen",
    "test:keygen": "node --test tests/generate-signing-key.test.mjs",
    "test:unit": "vitest run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "https://pkg.pr.new/@cloudflare/vitest-plugin@7b89dc48f3f4b0dfba5df352bcbdf8e2cbcff30e",
    "@types/node": "26.6.1",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "wrangler": "4.134.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
