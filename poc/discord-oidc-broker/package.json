{
  "name": "@acecore/discord-oidc-broker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "cf:typegen": "wrangler types && node scripts/normalize-generated-types.mjs",
    "check": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:keygen",
    "test:keygen": "node --test tests/generate-signing-key.test.mjs",
    "test:unit": "vitest run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@types/node": "26.5.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.131.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
