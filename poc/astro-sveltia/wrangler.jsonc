{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aceserver-wiki-astro",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "vectorize": [
    {
      "binding": "SEARCH_INDEX",
      "index_name": "aceserver-wiki-search-openai-1536-production",
    },
  ],
  "d1_databases": [
    {
      "binding": "CMS_DATABASE",
      "database_name": "aceserver-wiki-cms",
      "database_id": "5f7d4b1c-c8ce-4b03-bd69-eede626b3fe8",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "SKIP_DEPENDENCY_INSTALL": "1",
    "CMS_REPOSITORY_OWNER": "acecore-systems",
    "CMS_REPOSITORY_NAME": "aceserver-wiki",
    "CMS_REPOSITORY_BRANCH": "main",
    "CMS_CONTENT_ROOT": "poc/astro-sveltia/src/content/wiki",
    "CMS_MEDIA_ROOT": "poc/astro-sveltia/public/uploads/wiki",
    "CMS_PUBLICATION_MODE": "direct",
    "CMS_DISCORD_AUTHORIZATION_MODE": "guild",
    "CMS_DISCORD_GUILD_ID": "737538781024092170",
    "CMS_DISCORD_ALLOWED_ROLE_IDS": "",
    "SEARCH_ENABLED": "false",
    "SEARCH_MIN_SCORE": "0.40",
    "ALPHA_CHAT_ENABLED": "true",
    "OPENAI_RESPONSE_MODEL": "gpt-5.6-luna",
    "OPENAI_REASONING_EFFORT": "low",
    "OPENAI_EMBEDDING_MODEL": "text-embedding-3-large",
    "OPENAI_EMBEDDING_DIMENSIONS": "1536",
  },
  "env": {
    "preview": {
      "vectorize": [
        {
          "binding": "SEARCH_INDEX",
          "index_name": "aceserver-wiki-search-openai-1536-preview",
        },
      ],
      "d1_databases": [
        {
          "binding": "CMS_DATABASE",
          "database_name": "aceserver-wiki-cms-preview",
          "database_id": "6f1c4dff-9c89-4a34-bd4c-0de865b5f22d",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "SKIP_DEPENDENCY_INSTALL": "1",
        "CMS_REPOSITORY_OWNER": "acecore-systems",
        "CMS_REPOSITORY_NAME": "aceserver-wiki",
        "CMS_REPOSITORY_BRANCH": "main",
        "CMS_CONTENT_ROOT": "poc/astro-sveltia/src/content/wiki",
        "CMS_MEDIA_ROOT": "poc/astro-sveltia/public/uploads/wiki",
        "CMS_PUBLICATION_MODE": "disabled",
        "CMS_DISCORD_AUTHORIZATION_MODE": "guild",
        "CMS_DISCORD_GUILD_ID": "737538781024092170",
        "CMS_DISCORD_ALLOWED_ROLE_IDS": "",
        "SEARCH_ENABLED": "true",
        "SEARCH_MIN_SCORE": "0.40",
        "ALPHA_CHAT_ENABLED": "true",
        "OPENAI_RESPONSE_MODEL": "gpt-5.6-luna",
        "OPENAI_REASONING_EFFORT": "low",
        "OPENAI_EMBEDDING_MODEL": "text-embedding-3-large",
        "OPENAI_EMBEDDING_DIMENSIONS": "1536",
      },
    },
  },
}
