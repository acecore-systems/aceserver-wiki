---
import EditLink from './EditLink.astro'
import {
  HEADER_TITLE,
  WIKI_HEADER_LINKS,
  WIKI_ICON_PATH,
} from '../config/wiki'
import { articlePath, type WikiCategoryGroup } from '../lib/wiki'

interface Props {
  categories: WikiCategoryGroup[]
  currentId?: string
}

const { categories, currentId } = Astro.props
const isHome = Astro.url.pathname === '/'
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-title" href="/" aria-label={`${HEADER_TITLE} トップ`}>
      <span class="site-title__icon" aria-hidden="true">
        <img src={WIKI_ICON_PATH} alt="" width="24" height="24" />
      </span>
      <span class="site-title__text">{HEADER_TITLE}</span>
    </a>

    <nav class="site-links" aria-label="サイトメニュー">
      {
        WIKI_HEADER_LINKS.map((link) => (
          <a href={link.href}>{link.text}</a>
        ))
      }
      <EditLink />
    </nav>

    <form class="site-search" action="/search/" method="get" role="search">
      <label class="visually-hidden" for="header-search">サイト内検索</label>
      <input
        id="header-search"
        name="q"
        type="search"
        placeholder="サイト内検索"
        autocomplete="off"
      />
      <button type="submit">検索</button>
    </form>

    <details class="mobile-menu">
      <summary aria-label="記事メニュー">
        <span class="mobile-menu__icon" aria-hidden="true"></span>
        <span class="mobile-menu__label" aria-hidden="true">メニュー</span>
      </summary>
      <div class="mobile-menu__panel">
        <nav aria-label="モバイル記事メニュー">
          <ul class="mobile-menu__primary">
            <li>
              <a href="/" aria-current={isHome ? 'page' : undefined}>トップ</a>
            </li>
            {
              WIKI_HEADER_LINKS.map((link) => (
                <li>
                  <a href={link.href}>{link.text}</a>
                </li>
              ))
            }
            <li class="mobile-menu__edit">
              <EditLink />
            </li>
          </ul>

          <form
            class="mobile-menu__search"
            action="/search/"
            method="get"
            role="search"
          >
            <label for="mobile-search">サイト内検索</label>
            <div>
              <input
                id="mobile-search"
                name="q"
                type="search"
                autocomplete="off"
              />
              <button type="submit">検索</button>
            </div>
          </form>

          {
            categories.map((category) => (
              <section class="mobile-menu__category">
                <h2>{category.name}</h2>
                {category.articles.length > 0 ? (
                  <ul>
                    {category.articles.map((article) => (
                      <li>
                        <a
                          href={articlePath(article.id)}
                          aria-current={
                            currentId === article.id ? 'page' : undefined
                          }
                        >
                          {article.data.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="mobile-menu__empty">
                    現在、公開中の記事はありません。
                  </p>
                )}
              </section>
            ))
          }
        </nav>
      </div>
    </details>
  </div>
</header>

<script
  is:inline
  nonce="__CSP_NONCE__"
  src="/mobile-menu.js"
  defer
></script>
