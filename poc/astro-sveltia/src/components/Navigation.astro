---
import { articlePath, type WikiCategoryGroup } from '../lib/wiki'

interface Props {
  categories: WikiCategoryGroup[]
  currentId?: string
}

const { categories, currentId } = Astro.props
---

<nav class="side-navigation" aria-label="記事一覧">
  {
    categories.map((category) => (
      <section class="side-navigation__category">
        <h2>{category.name}</h2>
        {
          category.articles.length > 0 ? (
            <ul>
              {category.articles.map((article) => (
                <li>
                  <a
                    href={articlePath(article.id)}
                    aria-current={
                      currentId === article.id ? 'page' : undefined
                    }
                  >
                    {article.data.title}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="side-navigation__empty">
              現在、公開中の記事はありません。
            </p>
          )
        }
      </section>
    ))
  }
</nav>
