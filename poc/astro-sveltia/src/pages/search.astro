---
import { SEARCH_DESCRIPTION, SEARCH_META_TITLE } from '../config/wiki'
import WikiLayout from '../layouts/WikiLayout.astro'
import { getWikiArticles, groupWikiArticles } from '../lib/wiki'

const categories = groupWikiArticles(await getWikiArticles())
---

<WikiLayout
  title={SEARCH_META_TITLE}
  description={SEARCH_DESCRIPTION}
  canonicalPath="/search/"
  categories={categories}
  robots="noindex, follow"
>
  <section class="search-page" data-pagefind-ignore>
    <h1>サイト内検索</h1>
    <p class="search-page__description">{SEARCH_DESCRIPTION}</p>
    <form
      class="search-page__form"
      action="/search/"
      method="get"
      role="search"
    >
      <label class="visually-hidden" for="search-query">検索語</label>
      <input
        id="search-query"
        name="q"
        type="search"
        placeholder="記事を検索"
        autocomplete="off"
      />
      <button type="submit">検索</button>
    </form>
    <p class="search-page__privacy">
      検索語は公開情報との照合のためCloudflare Workers AIに送信されます。
    </p>
    <p class="search-status" aria-live="polite">検索語を入力してください。</p>
    <section
      class="search-page__results"
      data-local-search-results
      aria-labelledby="local-search-results-title"
      hidden
    >
      <h2 id="local-search-results-title">WIKIの検索結果</h2>
      <p class="search-page__authority">
        WIKIの規則・参加・運用情報は、ここに表示されるWIKI検索結果を正として確認してください。
      </p>
      <ol class="search-results" data-local-search-list></ol>
    </section>
    <section
      class="search-page__results search-page__results--network"
      data-network-search-results
      aria-labelledby="network-search-results-title"
      hidden
    >
      <h2 id="network-search-results-title">Acecore関連サイト</h2>
      <ol class="search-results" data-network-search-list></ol>
    </section>
  </section>
  <script is:inline nonce="__CSP_NONCE__" src="/search.js" defer></script>
</WikiLayout>
