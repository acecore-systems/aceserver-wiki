{
  "name": "@acecore/aceserver-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run build:astro && npm run test:build",
    "build:astro": "astro build",
    "check": "astro check",
    "migrate:newt-public": "node scripts/import-newt-public.mjs",
    "migrate:newt-public:check": "node scripts/import-newt-public.mjs --check",
    "snapshot:newt-public": "node scripts/snapshot-newt-public.mjs",
    "test": "npm run test:unit",
    "test:build": "node scripts/validate-build.mjs",
    "test:migration": "node scripts/validate-newt-migration.mjs",
    "test:migration:current": "npm run migrate:newt-public:check && node scripts/validate-newt-migration.mjs --current",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "cf:typegen": "wrangler types && node scripts/normalize-generated-types.mjs",
    "pages:dev": "npm run build && wrangler pages dev dist"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.1",
    "astro": "7.1.3",
    "graphql": "17.0.2",
    "jose": "6.2.4",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "@types/node": "26.1.1",
    "devalue": "5.8.2",
    "parse5": "^8.0.0",
    "turndown": "^7.2.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  }
}
