{
  "name": "@acecore/aceserver-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run build:astro && npm run build:pagefind && npm run build:meta && npm run test:build",
    "build:astro": "astro build",
    "build:pagefind": "pagefind --site dist",
    "build:meta": "node scripts/write-build-meta.mjs",
    "check": "astro check",
    "migrate:newt-drafts": "node scripts/import-newt-drafts.mjs",
    "migrate:newt-drafts:check": "node scripts/import-newt-drafts.mjs --check",
    "migrate:newt-public:check": "node scripts/import-newt-public.mjs --check",
    "search:sync": "node scripts/sync-vectorize.mjs",
    "search:sync:dry-run": "node scripts/sync-vectorize.mjs --dry-run",
    "test": "npm run test:unit && node --test tests/alpha-chat-ui.test.mjs && npm run test:vectorize && npm run test:migration:unit",
    "test:build": "node scripts/validate-build.mjs",
    "test:migration": "node scripts/validate-newt-migration.mjs",
    "test:migration:acceptance": "npm run migrate:newt-drafts:check && node scripts/validate-newt-full-migration.mjs",
    "test:migration:archive": "node scripts/validate-newt-full-archive.mjs",
    "test:migration:unit": "node --test --test-isolation=none tests/newt-draft-migration.test.mjs",
    "test:migration:legacy-acceptance": "npm run migrate:newt-public:check && node scripts/validate-newt-migration.mjs --current",
    "test:unit": "vitest run",
    "test:vectorize": "node --test tests/vectorize-sync.test.mjs tests/deployment-marker.test.mjs",
    "test:watch": "vitest",
    "cf:typegen": "wrangler types && wrangler types workers/discord-membership/worker-configuration.d.ts --config workers/discord-membership/wrangler.jsonc --env-interface MembershipEnv --include-runtime false && node scripts/normalize-generated-types.mjs",
    "membership:build": "wrangler deploy --dry-run --config workers/discord-membership/wrangler.jsonc",
    "pages:dev": "npm run build && wrangler pages dev dist"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "astro": "7.3.1",
    "graphql": "17.0.2",
    "jose": "6.2.10",
    "mdast-util-from-markdown": "2.0.3",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@types/node": "26.4.1",
    "devalue": "5.9.2",
    "pagefind": "^1.5.2",
    "parse5": "^8.0.1",
    "turndown": "^7.2.4",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.129.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
