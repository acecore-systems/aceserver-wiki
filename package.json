{
  "name": "aceserver-wiki",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.17.1",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "postinstall": "nuxt prepare",
    "dev": "nuxt",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "generate": "nuxt generate && node scripts/prepare-dist.mjs && node scripts/audit-generated-metadata.mjs",
    "test:seo": "node --test tests/seo.test.mjs tests/legacy-routes.test.mjs tests/image-alt.test.mjs",
    "audit:metadata": "node scripts/audit-generated-metadata.mjs",
    "lint:js": "eslint . --max-warnings=0",
    "lint:prettier": "prettier --check .",
    "lint": "yarn lint:js && yarn lint:prettier",
    "lintfix": "prettier --write . && yarn lint:js --fix",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "html-to-text": "10.0.0",
    "newt-client-js": "3.3.19",
    "nuxt": "4.5.0",
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.16.0",
    "@types/html-to-text": "9.0.4",
    "@types/node": "26.1.1",
    "@vue/compiler-sfc": "3.5.40",
    "eslint": "10.7.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vue-tsc": "3.3.8"
  },
  "resolutions": {
    "brace-expansion@npm:^2.0.1": "npm:2.1.2",
    "cross-spawn@npm:^7.0.3": "npm:7.0.6",
    "js-yaml@npm:^4.1.0": "npm:4.3.0",
    "picomatch@npm:^2.0.4": "npm:2.3.2",
    "picomatch@npm:^2.3.1": "npm:2.3.2"
  },
  "dependenciesMeta": {
    "esbuild": {
      "built": true
    },
    "unrs-resolver": {
      "built": true
    }
  }
}
